{
  "manifest_version": 3,
  "name": "Banablur",
  "version": "1.10.9",
  "description": "Peel the blur. Removes age-gate overlays and video blur on XVIDEOS, XNXX, xHamster, xHamsterLive, Chaturbate, LebonPorn, Tukif, FapHouse, AgeGO/Deviants, TNAFlix, TXXX, Jacquie, Stripchat and similar sites. Optional video download button. All requests use your local IP.",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Banablur"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://chaturbate.com/*",
        "*://*.chaturbate.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://lebon.porn/*",
        "*://*.lebon.porn/*",
        "*://videos.lebon.porn/*",
        "*://*.videos.lebon.porn/*",
        "*://tukif.porn/*",
        "*://*.tukif.porn/*",
        "*://videos.tukif.porn/*",
        "*://*.videos.tukif.porn/*"
      ],
      "js": ["lebonporn-page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://lebon.porn/*",
        "*://*.lebon.porn/*",
        "*://videos.lebon.porn/*",
        "*://*.videos.lebon.porn/*",
        "*://tukif.porn/*",
        "*://*.tukif.porn/*",
        "*://videos.tukif.porn/*",
        "*://*.videos.tukif.porn/*"
      ],
      "js": ["lebonporn-inject.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://chaturbate.com/*",
        "*://*.chaturbate.com/*"
      ],
      "css": ["chaturbate-gate.css"],
      "js": ["chaturbate.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "activeTab", "downloads"],
  "host_permissions": [
    "https://*.xvideos.com/*",
    "https://*.xnxx.com/*",
    "https://*.xvideos.es/*",
    "https://*.xnxx.es/*",
    "https://*.xvideos.red/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["chaturbate-page.js", "hls.min.js"],
      "matches": ["*://chaturbate.com/*", "*://*.chaturbate.com/*"]
    },
    {
      "resources": ["xvideos-page.js"],
      "matches": [
        "*://xvideos.com/*",
        "*://*.xvideos.com/*",
        "*://xnxx.com/*",
        "*://*.xnxx.com/*",
        "*://xvideos.es/*",
        "*://*.xvideos.es/*",
        "*://xnxx.es/*",
        "*://*.xnxx.es/*",
        "*://xvideos.red/*",
        "*://*.xvideos.red/*"
      ]
    },
    {
      "resources": ["xhamster-page.js"],
      "matches": [
        "*://xhamster.com/*",
        "*://*.xhamster.com/*",
        "*://xhamster.desi/*",
        "*://*.xhamster.desi/*"
      ]
    },
    {
      "resources": ["lebonporn-page.js"],
      "matches": [
        "*://lebon.porn/*",
        "*://*.lebon.porn/*",
        "*://videos.lebon.porn/*",
        "*://*.videos.lebon.porn/*",
        "*://tukif.porn/*",
        "*://*.tukif.porn/*",
        "*://videos.tukif.porn/*",
        "*://*.videos.tukif.porn/*"
      ]
    },
    {
      "resources": ["ageverif-page.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "agego-deblur@local.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
